# Copy this file to `.env` (already gitignored) and fill in real values.
# Never commit real API keys. Never send them to the frontend — the
# frontend only ever talks to this backend, never to Twelve Data directly.

# Free key from https://twelvedata.com/ (Account -> API Keys).
# Leave unset and the app runs fine — watchlist prices just show as
# DATA_UNAVAILABLE instead of a fabricated number.
TWELVE_DATA_API_KEY=

# Optional. Free key from https://www.alphavantage.co/support/#api-key
# enables real news headlines + sentiment on Screen 4 (News). Leave unset
# and that screen shows clearly-labeled preview headlines instead.
ALPHA_VANTAGE_API_KEY=
